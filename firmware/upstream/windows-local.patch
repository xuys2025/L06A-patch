diff --git a/bin/wifi_connect b/bin/wifi_connect
index 32d4b10..cad8cc1 100755
--- a/bin/wifi_connect
+++ b/bin/wifi_connect
@@ -9,6 +9,12 @@ SSID=$1
 PASSWORD=$2
 [ -z "$SILENT" ] && SILENT=0 # enable sounds
 WPA_CONFIG=/data/wifi/wpa_supplicant.conf
+# L06A/LX06 firmware 1.88.221 starts wpa_supplicant with wpa.conf.
+# Select the configuration file actually consumed by the installed wireless
+# service so Improv credentials survive the service restart.
+if grep -q '^WIRELESS_CONF="/data/wifi/wpa.conf"' /etc/init.d/wireless 2>/dev/null; then
+    WPA_CONFIG=/data/wifi/wpa.conf
+fi
 
 #echo "password lenght: ${#PASSWORD}"
 
@@ -47,18 +53,35 @@ for n in `seq 10`; do
     STATUS=$(timeout 1 wpa_cli status | grep wpa_state | cut -d'=' -f2)
 
     if [ "$STATUS" = "COMPLETED" ]; then
+        IP_WAIT=0
+        IP_ADDRESS=""
+        while [ "$IP_WAIT" -lt 30 ]; do
+            IP_ADDRESS=$(ifconfig wlan0 | grep 'inet ' | awk '{print $2}' | cut -d':' -f2)
+            [ -n "$IP_ADDRESS" ] && break
+            sleep 1
+            IP_WAIT=$((IP_WAIT + 1))
+        done
+
+        [ -e "${WPA_CONFIG}.bak" ] && rm ${WPA_CONFIG}.bak
+        if [ -z "$IP_ADDRESS" ]; then
+            echo "Wi-Fi associated, but DHCP did not provide an IP address."
+            [ "$SILENT" = 0 ] && miplay sound notice &
+            exit 1
+        fi
+
         echo "All done!"
         [ "$SILENT" = 0 ] && miplay sound multirounds_tone &
-        [ -e "${WPA_CONFIG}.bak" ] && rm ${WPA_CONFIG}.bak
 
         if [ -e "/etc/init.d/api" ] ; then
             /etc/init.d/api restart
 
+            API_WAIT=0
             until curl -so /dev/null 127.0.0.1 ; do
                 sleep 1
+                API_WAIT=$((API_WAIT + 1))
+                [ "$API_WAIT" -ge 30 ] && break
             done
 
-            IP_ADDRESS=$(ifconfig wlan0 | grep 'inet ' | awk '{print $2}' | cut -d':' -f2)
             echo "Configuration available at:"
             echo "http://${IP_ADDRESS}:80"
         fi
diff --git a/packages/shairport-sync/package.mk b/packages/shairport-sync/package.mk
index 7520a8b..138f5f1 100644
--- a/packages/shairport-sync/package.mk
+++ b/packages/shairport-sync/package.mk
@@ -49,6 +49,15 @@ configure_package() {
 }
 
 make_package() {
+	if [ "${ENABLE_AIRPLAY_2}" = "1" ]; then
+		# GLib 2.84's gdbus-codegen emits g_variant_builder_init_static(),
+		# which is unavailable in the target GLib 2.68.2. Generate the files
+		# first and use the compatible function with the same arguments.
+		make dbus-interface.c mpris-interface.c
+		sed -i -e "s/g_variant_builder_init_static/g_variant_builder_init/g" \
+			dbus-interface.c mpris-interface.c
+	fi
+
 	make -j${MAKE_JOBS}
 	EXITCODE=$?
 
